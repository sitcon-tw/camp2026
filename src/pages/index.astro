---
import Hero from "@/components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import BrandMarquee from "@/components/BrandMarquee.astro";
import MasterClass from "@/components/MasterClass.astro";
import MasterCarousel from "@/components/MasterCarousel.astro";
import AboutSitconCamp from "@/components/AboutSitconCamp.astro";
import StudentComment from "@/components/StudentComment.astro";
import RegistrationInfo from "@/components/RegistrationInfo.astro";
import FAQ from "@/components/FAQ.astro";
import OrganizersBrands from "@/components/OrganizerBrands.astro";
import homeData from "@/data/home.json";
import layoutData from "@/data/layout.json";
import { markdownToPlainText } from "@/utils/markdown";

const siteURL = Astro.site ?? new URL("https://sitcon.camp");
const homeURL = new URL("/", siteURL);
const ogImage = new URL("/og.jpg", siteURL);
const publisher = {
	"@type": "Organization",
	name: layoutData.organization.name,
	url: layoutData.organization.url
};

const eventSchema = {
	...layoutData.eventLD,
	image: [ogImage.href],
	organizer: {
		...layoutData.eventLD.organizer,
		sameAs: layoutData.organization.sameAs
	},
	url: homeURL.href
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: layoutData.document.brandName,
	url: homeURL.href,
	description: layoutData.document.description,
	inLanguage: layoutData.document.lang,
	publisher
};

const organizationSchema = {
	"@context": "https://schema.org",
	...publisher,
	logo: new URL("/favicon.svg", siteURL).href,
	sameAs: layoutData.organization.sameAs
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: homeData.faq.items.map(item => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: markdownToPlainText(item.answer)
		}
	}))
};

const structuredData = [eventSchema, websiteSchema, organizationSchema, faqSchema];
---

<Layout additionalStructuredData={structuredData}>
	<Hero />
	<BrandMarquee />
	<MasterClass />
	<MasterCarousel />
	<AboutSitconCamp />
	<StudentComment />
	<RegistrationInfo />
	<FAQ />
	<OrganizersBrands />
</Layout>
