---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Info from "~icons/lucide/info";
import X from "~icons/lucide/x";
import { dayAccentClassMap, fallbackSessionTypeBadgeClass, scheduleDayConfigs, scheduleImageAliases, scheduleMeta, sessionTypeBadgeClassMap } from "@/data/schedule-config";
import scheduleJson from "@/data/generated/schedule.json";
import type { ScheduleData, ScheduleSession, ScheduleSpeaker } from "@/types/schedule";
import { renderMarkdown } from "@/utils/markdown";

const scheduleData = scheduleJson as ScheduleData;
const scheduleImageModules = import.meta.glob<{ default: ImageMetadata }>("../assets/schedule/*.{jpg,jpeg,png,webp}", { eager: true });
const scheduleImages = new Map(
	Object.entries(scheduleImageModules).map(([path, mod]) => {
		const filename = path.split("/").pop() ?? path;
		const key = filename.replace(/\.(jpe?g|png|webp)$/i, "");
		return [key, mod.default];
	})
);
const speakerAvatarModules = import.meta.glob<{ default: ImageMetadata }>(["../assets/speakers/*.{jpg,jpeg,png,webp}", "../assets/feature-members/*.{jpg,jpeg,png,webp}"], { eager: true });
const speakerAvatars = new Map(
	Object.entries(speakerAvatarModules).map(([path, mod]) => {
		const filename = path.split("/").pop() ?? path;
		const key = filename.replace(/\.(jpe?g|png|webp)$/i, "");
		return [key, mod.default];
	})
);

interface ScheduleEvent {
	id: string;
	name: string;
	category: string;
	type: string;
	description: string[];
	speakers: string[];
	image?: {
		key: string;
		alt: string;
	};
}

interface ScheduleBlock {
	startSlot: string;
	endSlot: string;
	event: ScheduleEvent;
	label: string;
	rowStart: number;
	span: number;
	isInteractive: boolean;
}

interface ScheduleDay {
	id: string;
	title: string[];
	date: string;
	subtitle: string;
	type: (typeof scheduleDayConfigs)[keyof typeof scheduleDayConfigs]["type"];
	blocks: ScheduleBlock[];
}

const normalizeAssetKey = (value: string): string =>
	value
		.trim()
		.toLowerCase()
		.replace(/[_\s]+/g, "-")
		.replace(/\.(jpe?g|png|webp)$/i, "")
		.replace(/-day\d+(?:-[a-z0-9]+)?$/i, "")
		.replace(/-$/, "");

const parseScheduleDate = (value: string): Date => {
	const date = new Date(value);

	if (Number.isNaN(date.getTime())) {
		throw new Error(`Invalid schedule date: ${value}`);
	}

	return date;
};

const formatHourSlot = (value: string): string => {
	const timeMatch = value.match(/T(\d{2}):\d{2}/);

	if (!timeMatch) {
		throw new Error(`Invalid schedule ISO time: ${value}`);
	}

	return `${Number(timeMatch[1])}:00`;
};
const getSlotTime = (slot: string): number => Number(slot.split(":")[0]);

const sessionTypesById = new Map(scheduleData.session_types.map(type => [type.id, type]));
const speakersById = new Map(scheduleData.speakers.map(speaker => [speaker.id, speaker]));

const getSessionTypeName = (session: ScheduleSession): string => {
	const sessionType = sessionTypesById.get(session.type);
	return sessionType?.zh.name || sessionType?.en.name || session.type || "其他";
};

const getBadgeClass = (event: ScheduleEvent): string => sessionTypeBadgeClassMap[event.category] ?? sessionTypeBadgeClassMap[event.type] ?? fallbackSessionTypeBadgeClass;

const resolveScheduleImage = (event: Pick<ScheduleEvent, "id" | "name">): ScheduleEvent["image"] | undefined => {
	const alias = scheduleImageAliases[event.id];

	if (scheduleImages.has(event.id)) {
		return { key: event.id, alt: event.name };
	}

	const normalizedKey = normalizeAssetKey(event.id);
	if (scheduleImages.has(normalizedKey)) {
		return { key: normalizedKey, alt: event.name };
	}

	return alias;
};

const getEvent = (eventId: string): ScheduleEvent => {
	const event = scheduleEventsById.get(eventId);

	if (!event) {
		throw new Error(`Missing schedule event: ${eventId}`);
	}

	return event;
};

const getScheduleImage = (event: ScheduleEvent): ImageMetadata | undefined => {
	const imageKey = event.image?.key;

	if (!imageKey) {
		return undefined;
	}

	const image = scheduleImages.get(imageKey);

	if (!image) {
		throw new Error(`Missing schedule image asset: ${imageKey}`);
	}

	return image;
};

const getSpeakerAvatar = (speaker: ScheduleSpeaker): ImageMetadata | undefined => {
	const avatarKey = speaker.avatar ? normalizeAssetKey(speaker.avatar.split("/").pop() ?? speaker.avatar) : speaker.id;

	if (!avatarKey) {
		return undefined;
	}

	return speakerAvatars.get(avatarKey);
};

const getSpeakerName = (speaker: ScheduleSpeaker): string => speaker.zh.name || speaker.en.name;
const getSpeakerDescription = (speaker: ScheduleSpeaker): string => speaker.zh.bio || speaker.en.bio;
const hasSpeakerContent = (speaker: ScheduleSpeaker): boolean => Boolean(getSpeakerName(speaker).trim() || getSpeakerDescription(speaker).trim() || speaker.avatar?.trim());

const getEventSpeakers = (event: ScheduleEvent): ScheduleSpeaker[] =>
	(event.speakers ?? [])
		.map(speakerId => {
			const speaker = speakersById.get(speakerId);

			if (!speaker) {
				throw new Error(`Missing schedule speaker: ${speakerId}`);
			}

			return speaker;
		})
		.filter(hasSpeakerContent);

const hasEventDetails = (event: ScheduleEvent): boolean => {
	const descriptionLines = event.description ?? [];
	return Boolean(event.image?.key || descriptionLines.some(line => line.trim()) || getEventSpeakers(event).length > 0);
};

const descriptionLinesToMarkdown = (lines: string[]): string =>
	lines.reduce((markdown, line) => {
		const previousLine = markdown.split("\n").at(-1) ?? "";
		const joinsList = /^[-*+]\s+/.test(line) && /^[-*+]\s+/.test(previousLine);
		const separator = joinsList ? "\n" : "\n\n";

		return markdown ? `${markdown}${separator}${line}` : line;
	}, "");

const getBlockSpan = (block: Pick<ScheduleBlock, "startSlot" | "span">): number => {
	const startIndex = scheduleSlotIndexMap.get(block.startSlot);

	if (startIndex === undefined) {
		throw new Error(`Invalid schedule slot: ${block.startSlot}`);
	}

	const remainingPeriods = scheduleSlots.length - startIndex;
	return Math.max(1, Math.min(block.span ?? 1, remainingPeriods));
};

const getBlockRangeLabel = (block: Pick<ScheduleBlock, "startSlot" | "endSlot" | "span">): string => {
	const startIndex = scheduleSlotIndexMap.get(block.startSlot);

	if (startIndex === undefined) {
		throw new Error(`Invalid schedule slot: ${block.startSlot}`);
	}

	const span = getBlockSpan(block);
	const endSlot = block.endSlot || scheduleSlots[startIndex + span - 1];

	return block.startSlot === endSlot ? block.startSlot : `${block.startSlot} - ${endSlot}`;
};

const getRenderableBlocks = (day: ScheduleDay) => {
	const occupiedSlots = Array.from({ length: scheduleSlots.length }, () => false);
	const blocks = day.blocks.map(block => {
		const startIndex = scheduleSlotIndexMap.get(block.startSlot);

		if (startIndex === undefined) {
			throw new Error(`Invalid schedule slot: ${block.startSlot}`);
		}

		const span = getBlockSpan(block);

		for (let offset = 0; offset < span; offset += 1) {
			const slotIndex = startIndex + offset;

			if (occupiedSlots[slotIndex]) {
				throw new Error(`Overlapping schedule blocks in day: ${day.id}`);
			}

			occupiedSlots[slotIndex] = true;
		}

		return {
			...block,
			isInteractive: hasEventDetails(block.event),
			label: getBlockRangeLabel(block),
			rowStart: startIndex + 2,
			span
		};
	});

	const emptyBlocks = scheduleSlots.flatMap((slot, index) =>
		occupiedSlots[index]
			? []
			: [
					{
						startSlot: slot,
						span: 1,
						event: null,
						isInteractive: false,
						label: slot,
						rowStart: index + 2
					}
				]
	);

	return [...blocks, ...emptyBlocks].sort((left, right) => left.rowStart - right.rowStart);
};

const scheduleEventsById = new Map(
	scheduleData.sessions.map(session => {
		const name = session.zh.title || session.en.title || session.id;
		const event: ScheduleEvent = {
			id: session.id,
			name,
			category: getSessionTypeName(session),
			type: session.type,
			description: (session.zh.description || session.en.description).split(/\r?\n/),
			speakers: session.speakers,
			image: resolveScheduleImage({ id: session.id, name })
		};

		return [event.id, event];
	})
);

const sessionsWithDates = scheduleData.sessions.map(session => ({
	session,
	startDate: parseScheduleDate(session.start),
	endDate: parseScheduleDate(session.end),
	startSlot: formatHourSlot(session.start),
	endSlot: formatHourSlot(session.end)
}));
const minStartHour = Math.min(...sessionsWithDates.map(({ startSlot }) => getSlotTime(startSlot)));
const maxEndHour = Math.max(...sessionsWithDates.map(({ endSlot }) => getSlotTime(endSlot)));
const scheduleSlots = Array.from({ length: Math.max(0, maxEndHour - minStartHour) }, (_, index) => `${minStartHour + index}:00`);
const scheduleSlotIndexMap = new Map(scheduleSlots.map((slot, index) => [slot, index]));
const scheduleSlotCount = scheduleSlots.length;
const scheduleDays = Object.entries(
	sessionsWithDates.reduce<Record<string, typeof sessionsWithDates>>((days, entry) => {
		const daySessions = days[entry.session.room] ?? [];
		daySessions.push(entry);
		days[entry.session.room] = daySessions;
		return days;
	}, {})
)
	.sort(([leftRoom], [rightRoom]) => leftRoom.localeCompare(rightRoom, "en", { numeric: true }))
	.map(([room, entries]) => {
		const dayConfig = scheduleDayConfigs[room] ?? {
			title: [room],
			date: "",
			subtitle: room,
			type: "opening" as const
		};

		return {
			id: room,
			...dayConfig,
			blocks: entries
				.sort((left, right) => left.startDate.getTime() - right.startDate.getTime())
				.map(({ session, startSlot, endSlot }) => {
					const span = Math.max(1, getSlotTime(endSlot) - getSlotTime(startSlot));

					return {
						startSlot,
						endSlot,
						event: getEvent(session.id),
						label: startSlot,
						rowStart: 1,
						span,
						isInteractive: false
					};
				})
		};
	});
const interactiveScheduleEvents = Array.from(scheduleEventsById.values()).filter(hasEventDetails);
---

<section class="schedule-page" aria-labelledby="schedule-title">
	<div class="schedule-page__content" data-schedule-page-content>
		<div class="site-container">
			<header class="schedule-hero">
				<p class="schedule-hero__eyebrow">SITCON Camp 2026</p>
				<h1 id="schedule-title" class="schedule-hero__title">{scheduleMeta.title}</h1>
				<p class="schedule-hero__lead">{scheduleMeta.description}</p>
			</header>

			{
				scheduleMeta.note && (
					<div class="schedule-notes" aria-label="課表公告">
						<p class="schedule-note">{scheduleMeta.note}</p>
					</div>
				)
			}

			<div class="schedule-board schedule-board--scroll" style={`--schedule-slot-count:${scheduleSlotCount};`} aria-label="五天活動日程輪廓">
				<div class="schedule-time-rail" aria-hidden="true">
					<div class="schedule-time-rail__spacer"></div>
					{scheduleSlots.map(slot => <div class="schedule-time-rail__period">{slot}</div>)}
				</div>

				<div class="schedule-days-track" data-schedule-days-track>
					{
						scheduleDays.map(day => (
							<article class:list={["schedule-day", dayAccentClassMap[day.type]]}>
								<header class="schedule-day__header">
									<div class="schedule-day__header-copy">
										<h2 class="schedule-day__title">
											{day.title.flatMap((entry, index) =>
												index === 0 ? [<span class="schedule-day__title-entry">{entry}</span>] : [<wbr />, <span class="schedule-day__title-entry">{entry}</span>]
											)}
										</h2>
										<p class="schedule-day__subtitle">
											{day.subtitle}
											<span class="schedule-day__date"> - {day.date}</span>
										</p>
									</div>
								</header>

								<div class="schedule-day__blocks">
									{getRenderableBlocks(day).map(block => {
										const event = block.event;
										const isInteractive = block.isInteractive;

										return (
											<section
												class:list={[
													"schedule-block",
													{
														"schedule-block--empty": event === null,
														"schedule-block--spanning": block.span > 1
													}
												]}
												style={`--schedule-block-row:${block.rowStart}; --schedule-block-span:${block.span};`}
												aria-label={`${day.title.join(" ")}${block.label}活動`}
											>
												<h3 class="schedule-block__period">{block.label}</h3>
												{event ? (
													<div class="schedule-block__events">
														{isInteractive ? (
															<button
																type="button"
																class:list={["schedule-event", { "schedule-event--spanning": block.span > 1 }]}
																data-schedule-event-trigger={event.id}
																aria-label={`查看${event.name}介紹`}
															>
																<div class="schedule-event__body">
																	<div class="schedule-event__content">
																		<span class:list={["schedule-event__badge", getBadgeClass(event)]}>{event.category}</span>
																		<span class="schedule-event__name">{event.name}</span>
																	</div>
																</div>
																<Info class="schedule-event__info-icon" width={18} height={18} stroke-width={3} aria-hidden="true" />
															</button>
														) : (
															<div class:list={["schedule-event", "schedule-event--static", { "schedule-event--spanning": block.span > 1 }]}>
																<div class="schedule-event__body">
																	<div class="schedule-event__content">
																		<span class:list={["schedule-event__badge", getBadgeClass(event)]}>{event.category}</span>
																		<span class="schedule-event__name">{event.name}</span>
																	</div>
																</div>
															</div>
														)}
													</div>
												) : (
													<p class="schedule-block__empty-text"> </p>
												)}
											</section>
										);
									})}
								</div>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</div>

	{
		interactiveScheduleEvents.map(event => (
			<div class="schedule-dialog" data-schedule-dialog={event.id} role="dialog" aria-modal="true" aria-labelledby={`schedule-dialog-title-${event.id}`} hidden>
				{(() => {
					const descriptionLines = event.description ?? [];
					const image = getScheduleImage(event);
					const imageAlt = event.image?.alt ?? "";
					const speakers = getEventSpeakers(event);

					return (
						<div class:list={["schedule-dialog__panel", { "schedule-dialog__panel--no-image": !image }]}>
							{image && (
								<div class="schedule-dialog__image-wrap">
									<Image
										class="schedule-dialog__image"
										src={image}
										alt={imageAlt}
										loading="lazy"
										decoding="async"
										format="webp"
										widths={[640, 960, 1280, 1600]}
										sizes="(max-width: 72rem) 100vw, 52vw"
									/>
								</div>
							)}
							<div class="schedule-dialog__content">
								<span class:list={["schedule-dialog__badge", getBadgeClass(event)]}>{event.category}</span>
								<h2 id={`schedule-dialog-title-${event.id}`} class="schedule-dialog__title" tabindex="-1">
									{event.name}
								</h2>
								{descriptionLines.some(line => line.trim()) && <div class="schedule-dialog__description" set:html={renderMarkdown(descriptionLinesToMarkdown(descriptionLines))} />}
								{speakers.length > 0 && (
									<section class="schedule-dialog__speakers" aria-label={`${event.name}講者`}>
										{speakers.map(speaker => {
											const avatar = getSpeakerAvatar(speaker);
											const speakerName = getSpeakerName(speaker).trim();
											const speakerDescription = getSpeakerDescription(speaker).trim();

											return (
												<article class="schedule-speaker">
													{avatar ? (
														<Image class="schedule-speaker__avatar" src={avatar} alt={speakerName} loading="lazy" decoding="async" format="webp" width={72} height={72} />
													) : (
														<div class="schedule-speaker__avatar schedule-speaker__avatar--placeholder" aria-hidden="true">
															{speakerName.charAt(0)}
														</div>
													)}
													<div class="schedule-speaker__content">
														{speakerName && <h3 class="schedule-speaker__name">{speakerName}</h3>}
														<p class:list={["schedule-speaker__description", { "schedule-speaker__description--pending": !speakerDescription }]}>{speakerDescription || "講者介紹即將公開"}</p>
													</div>
												</article>
											);
										})}
									</section>
								)}
							</div>
							<button type="button" class="schedule-dialog__close" data-schedule-dialog-close aria-label={`關閉${event.name}介紹`}>
								<X width={24} height={24} stroke-width={3} />
							</button>
						</div>
					);
				})()}
			</div>
		))
	}
</section>

<script>
	document.addEventListener("astro:page-load", () => {
		const ac = new AbortController();
		const { signal } = ac;
		document.addEventListener(
			"astro:before-swap",
			() => {
				closeDialog();
				ac.abort();
			},
			{ once: true }
		);

		const dialogs = new Map(Array.from(document.querySelectorAll<HTMLElement>("[data-schedule-dialog]")).map(dialog => [dialog.dataset.scheduleDialog ?? "", dialog]));
		const pageContent = document.querySelector<HTMLElement>("[data-schedule-page-content]");
		let activeDialog: HTMLElement | null = null;
		let lastFocusedElement: HTMLElement | null = null;
		let scrollPosition = 0;
		const focusableSelector = [
			"a[href]",
			"button:not([disabled])",
			'input:not([disabled]):not([type="hidden"])',
			"select:not([disabled])",
			"textarea:not([disabled])",
			'[tabindex]:not([tabindex="-1"])'
		].join(",");

		const getFocusableElements = (dialog: HTMLElement) => Array.from(dialog.querySelectorAll<HTMLElement>(focusableSelector)).filter(element => !element.closest("[hidden]"));

		const setPageContentInert = (isInert: boolean) => {
			if (!pageContent) return;

			const pageContentWithInert = pageContent as HTMLElement & { inert?: boolean };
			if ("inert" in pageContentWithInert) {
				pageContentWithInert.inert = isInert;
			}
			pageContent.toggleAttribute("inert", isInert);
			if (isInert) {
				pageContent.setAttribute("aria-hidden", "true");
			} else {
				pageContent.removeAttribute("aria-hidden");
			}
		};

		const focusDialogTitle = (dialog: HTMLElement) => {
			dialog.querySelector<HTMLElement>(`[id="schedule-dialog-title-${dialog.dataset.scheduleDialog ?? ""}"]`)?.focus({ preventScroll: true });
		};

		const restoreFocus = (dialog: HTMLElement | null) => {
			const fallbackTrigger = dialog?.dataset.scheduleDialog ? document.querySelector<HTMLElement>(`[data-schedule-event-trigger="${dialog.dataset.scheduleDialog}"]`) : null;
			const target = lastFocusedElement && lastFocusedElement.isConnected && (!dialog || !dialog.contains(lastFocusedElement)) ? lastFocusedElement : fallbackTrigger;

			target?.focus({ preventScroll: true });
			lastFocusedElement = null;
		};

		const closeDialog = (dialog = activeDialog) => {
			if (!dialog) return;

			dialog.hidden = true;
			setPageContentInert(false);
			activeDialog = null;
			document.documentElement.classList.remove("schedule-dialog-is-open");
			window.scrollTo({ top: scrollPosition, left: 0, behavior: "instant" });
			restoreFocus(dialog);
		};

		const openDialog = (dialog: HTMLElement) => {
			if (activeDialog && activeDialog !== dialog) {
				closeDialog(activeDialog);
			}

			lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			scrollPosition = window.scrollY;
			setPageContentInert(true);
			document.documentElement.classList.add("schedule-dialog-is-open");
			dialog.hidden = false;
			activeDialog = dialog;
			focusDialogTitle(dialog);
			if (document.activeElement === lastFocusedElement) {
				dialog.querySelector<HTMLElement>("[data-schedule-dialog-close]")?.focus({ preventScroll: true });
			}
		};

		document.addEventListener(
			"click",
			event => {
				if (!(event.target instanceof Element)) return;

				const trigger = event.target.closest<HTMLElement>("[data-schedule-event-trigger]");
				const closeButton = event.target.closest<HTMLElement>("[data-schedule-dialog-close]");

				if (trigger) {
					const dialog = dialogs.get(trigger.dataset.scheduleEventTrigger ?? "");
					if (dialog) {
						openDialog(dialog);
					}
					return;
				}

				if (closeButton) {
					closeDialog(closeButton.closest<HTMLElement>("[data-schedule-dialog]"));
				}
			},
			{ signal }
		);

		document.addEventListener(
			"keydown",
			event => {
				if (event.key === "Escape" && activeDialog) {
					closeDialog();
					return;
				}

				if (event.key !== "Tab" || !activeDialog) {
					return;
				}

				const focusables = getFocusableElements(activeDialog);

				if (focusables.length === 0) {
					event.preventDefault();
					return;
				}

				const currentIndex = focusables.indexOf(document.activeElement as HTMLElement);
				const nextIndex = event.shiftKey ? (currentIndex <= 0 ? focusables.length - 1 : currentIndex - 1) : currentIndex === -1 || currentIndex === focusables.length - 1 ? 0 : currentIndex + 1;

				event.preventDefault();
				focusables[nextIndex]?.focus({ preventScroll: true });
			},
			{ signal }
		);

		document.addEventListener(
			"focusin",
			event => {
				if (!activeDialog || !(event.target instanceof Node) || activeDialog.contains(event.target)) return;

				const focusables = getFocusableElements(activeDialog);
				(focusables[0] ?? activeDialog.querySelector<HTMLElement>("[data-schedule-dialog-close]"))?.focus({ preventScroll: true });
			},
			{ signal }
		);

		dialogs.forEach(dialog => {
			dialog.addEventListener(
				"click",
				event => {
					if (event.target === dialog) {
						closeDialog(dialog);
					}
				},
				{ signal }
			);
		});
	});
</script>

<style>
	.schedule-page {
		overflow: hidden;
		padding-block: clamp(8.25rem, 12vw, 12rem) clamp(3.5rem, 7vw, 6rem);
		background: var(--color-background);
		color: var(--color-foreground);
	}

	:global(html),
	:global(body) {
		overflow-x: hidden;
	}

	@supports (overflow-x: clip) {
		:global(html),
		:global(body) {
			overflow-x: clip;
		}
	}

	:global(html.schedule-dialog-is-open) {
		overflow: hidden;
		overscroll-behavior: none;
	}

	:global(html.schedule-dialog-is-open body) {
		overflow: hidden;
		overscroll-behavior: none;
	}

	.schedule-hero {
		display: grid;
		gap: clamp(1rem, 2vw, 1.5rem);
		max-width: var(--site-content-max);
	}

	.schedule-hero__eyebrow {
		width: fit-content;
		margin: 0;
		padding: 0.55rem 0.85rem;
		background: var(--color-green);
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		font-weight: 800;
		line-height: 1;
	}

	.schedule-hero__title {
		margin: 0;
		font-size: clamp(3rem, 8vw, 6.8rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.02;
		text-wrap: balance;
	}

	.schedule-hero__lead {
		max-width: var(--site-content-max);
		margin: 0;
		color: color-mix(in srgb, var(--color-foreground) 76%, transparent);
		font-size: clamp(1.1rem, 2vw, 1.45rem);
		font-weight: 700;
		line-height: 1.65;
	}

	.schedule-board {
		display: grid;
		grid-template-columns: clamp(3.25rem, 5vw, 4.25rem) minmax(0, 1fr);
		gap: clamp(0.75rem, 1.2vw, 1rem);
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin-block-start: clamp(2.5rem, 5vw, 4.5rem);
		--schedule-row-gap: clamp(0.32rem, 0.65vw, 0.52rem);
		--schedule-header-row: clamp(5.5rem, 7.4vw, 6.8rem);
		--schedule-slot-row: clamp(4.6rem, 5.7vw, 5.65rem);
	}

	.schedule-time-rail {
		display: grid;
		grid-template-rows: var(--schedule-header-row) repeat(var(--schedule-slot-count), var(--schedule-slot-row));
		gap: var(--schedule-row-gap);
	}

	.schedule-time-rail__spacer {
		border: 3px solid transparent;
	}

	.schedule-time-rail__period {
		display: grid;
		place-items: center;
		padding: 0.45rem 0.2rem;
		color: var(--color-background);
		background: var(--color-foreground);
		border-radius: 0.85rem 0;
		font-size: clamp(0.82rem, 1vw, 1rem);
		font-weight: 800;
		line-height: 1;
		box-shadow: 0.14rem 0.14rem 0 0 var(--color-orange);
	}

	.schedule-days-track {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.2vw, 1rem);
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.schedule-days-track {
		scrollbar-color: var(--color-foreground) color-mix(in srgb, var(--color-foreground) 14%, transparent);
		scrollbar-width: thin;
	}

	.schedule-days-track::-webkit-scrollbar {
		height: 0.55rem;
	}

	.schedule-days-track::-webkit-scrollbar-track {
		background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
		border-radius: 999rem;
	}

	.schedule-days-track::-webkit-scrollbar-thumb {
		background: var(--color-foreground);
		border-radius: 999rem;
	}

	.schedule-board--scroll {
		--schedule-header-row: clamp(7.75rem, 9vw, 9rem);
	}

	.schedule-day {
		display: grid;
		grid-template-rows: var(--schedule-header-row) repeat(var(--schedule-slot-count), var(--schedule-slot-row));
		gap: var(--schedule-row-gap);
		min-width: 0;
		overflow: hidden;
		background: var(--color-foreground);
		border: 3px solid var(--color-foreground);
		border-radius: 1.4rem 0;
		box-shadow: 0.28rem 0.28rem 0 0 var(--day-accent);
		transition:
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.schedule-day--green {
		--day-accent: var(--color-green);
	}

	.schedule-day--blue {
		--day-accent: var(--color-primary-blue);
	}

	.schedule-day--sky {
		--day-accent: var(--color-soft-blue);
	}

	.schedule-day--orange {
		--day-accent: var(--color-orange);
	}

	.schedule-day--dark {
		--day-accent: var(--color-dark-green);
	}

	.schedule-day__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.45rem;
		padding: clamp(0.65rem, 1.2vw, 1rem);
		color: var(--color-background);
		background: var(--day-accent);
	}

	.schedule-day__header-copy {
		display: grid;
		min-width: 0;
		gap: 0.45rem;
	}

	.schedule-day--blue .schedule-day__header,
	.schedule-day--dark .schedule-day__header {
		color: var(--color-background);
	}

	.schedule-day--green .schedule-day__header,
	.schedule-day--orange .schedule-day__header,
	.schedule-day--sky .schedule-day__header {
		color: var(--color-foreground);
	}

	.schedule-day__subtitle,
	.schedule-day__date,
	.schedule-day__title {
		margin: 0;
	}

	.schedule-day__subtitle {
		font-size: clamp(0.68rem, 0.8vw, 0.82rem);
		font-weight: 800;
		line-height: 1.2;
		opacity: 0.82;
	}

	.schedule-day__date {
		font-size: clamp(0.68rem, 0.8vw, 0.82rem);
		font-weight: 800;
		line-height: 1.2;
		opacity: 0.7;
	}

	.schedule-day__title {
		font-size: clamp(1.25rem, 1.65vw, 1.72rem);
		font-weight: 800;
		line-height: 1.15;
	}

	.schedule-day__title-entry {
		white-space: nowrap;
	}

	.schedule-day__blocks {
		display: contents;
	}

	.schedule-block {
		display: grid;
		grid-row: var(--schedule-block-row) / span var(--schedule-block-span);
		min-height: 0;
		padding: clamp(0.28rem, 0.55vw, 0.46rem);
		box-shadow: inset 0 3px 0 0 var(--color-foreground);
	}

	.schedule-block__period {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
		margin: 0;
	}

	.schedule-block__events {
		display: grid;
		grid-auto-rows: minmax(0, 1fr);
		gap: 0;
		height: 100%;
		min-height: 0;
	}

	.schedule-block__empty-text {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		margin: 0;
		padding: 0.8rem;
		color: color-mix(in srgb, var(--color-background) 72%, transparent);
		border: 2px dashed color-mix(in srgb, var(--color-background) 34%, transparent);
		border-radius: 0.7rem 0;
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.45;
		text-align: center;
	}

	.schedule-event {
		position: relative;
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		width: 100%;
		height: 100%;
		min-height: 0;
		padding: 0;
		color: var(--color-foreground);
		text-align: left;
		cursor: pointer;
		background: var(--color-white);
		border: 0;
		border-radius: 0.72rem 0;
		box-shadow: 0.16rem 0.16rem 0 0 var(--day-accent);
		transition:
			transform 160ms ease,
			box-shadow 160ms ease,
			background 160ms ease;
	}

	.schedule-event__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 100%;
		min-height: 0;
		padding: clamp(0.5rem, 0.72vw, 0.7rem);
	}

	.schedule-event:not(.schedule-event--static) .schedule-event__body {
		padding-inline-end: clamp(1.75rem, 2vw, 2rem);
	}

	.schedule-event__content {
		display: flex;
		flex-direction: column;
		gap: clamp(0.18rem, 0.32vw, 0.32rem);
	}

	.schedule-event__info-icon {
		position: absolute;
		inset-inline-end: 0.42rem;
		inset-block-end: 0.42rem;
		width: clamp(1rem, 1.2vw, 1.18rem);
		height: clamp(1rem, 1.2vw, 1.18rem);
		color: color-mix(in srgb, var(--color-foreground) 78%, var(--day-accent));
		pointer-events: none;
		opacity: 0.72;
		transition:
			color 160ms ease,
			opacity 160ms ease,
			transform 160ms ease;
	}

	.schedule-event:not(.schedule-event--static):hover,
	.schedule-event:focus-visible {
		background: color-mix(in srgb, var(--color-white) 78%, var(--day-accent));
		transform: translate(-0.08rem, -0.08rem);
		box-shadow: 0.28rem 0.28rem 0 0 var(--day-accent);
	}

	.schedule-event:not(.schedule-event--static):hover .schedule-event__info-icon,
	.schedule-event:focus-visible .schedule-event__info-icon {
		color: var(--color-foreground);
		opacity: 0.94;
		transform: scale(1.05);
	}

	.schedule-event--static {
		cursor: default;
	}

	.schedule-event:focus-visible,
	.schedule-dialog__close:focus-visible {
		outline: 0.2rem solid var(--color-soft-blue);
		outline-offset: 0.18rem;
	}

	.schedule-event__badge,
	.schedule-dialog__badge {
		align-self: start;
		width: fit-content;
		padding: 0.26rem 0.55rem;
		border-radius: 999rem;
		font-size: clamp(0.64rem, 0.68vw, 0.74rem);
		font-weight: 800;
		line-height: 1;
	}

	.schedule-event__name {
		display: -webkit-box;
		font-size: clamp(1.05rem, 1.08vw, 1.22rem);
		font-weight: 800;
		line-height: 1.18;
		overflow: hidden;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.schedule-event__summary {
		display: -webkit-box;
		color: color-mix(in srgb, var(--color-foreground) 64%, transparent);
		font-size: clamp(0.72rem, 0.72vw, 0.84rem);
		font-weight: 700;
		line-height: 1.35;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
	}

	.schedule-event--spanning .schedule-event__summary {
		-webkit-line-clamp: 3;
	}

	.schedule-badge--green {
		color: var(--color-foreground);
		background: color-mix(in srgb, var(--color-green) 70%, white);
	}

	.schedule-badge--blue {
		color: var(--color-background);
		background: var(--color-primary-blue);
	}

	.schedule-badge--sky {
		color: var(--color-foreground);
		background: color-mix(in srgb, var(--color-soft-blue) 70%, white);
	}

	.schedule-badge--orange {
		color: var(--color-foreground);
		background: color-mix(in srgb, var(--color-orange) 78%, white);
	}

	.schedule-badge--dark {
		color: var(--color-background);
		background: var(--color-dark-green);
	}

	.schedule-badge--lavender {
		color: var(--color-background);
		background: color-mix(in srgb, var(--color-foreground) 86%, var(--color-primary-blue));
	}

	.schedule-notes {
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		margin-block-start: clamp(2rem, 4vw, 3rem);
	}

	.schedule-note {
		width: fit-content;
		max-width: 52rem;
		margin: 0;
		padding: 1rem 1.2rem;
		color: color-mix(in srgb, var(--color-foreground) 78%, transparent);
		background: color-mix(in srgb, var(--color-green) 32%, var(--color-background));
		border-radius: 1rem 0;
		font-size: clamp(0.98rem, 1.6vw, 1.12rem);
		font-weight: 800;
		line-height: 1.55;
		text-align: center;
	}

	.schedule-dialog {
		position: fixed;
		inset: 0;
		z-index: 1100;
		display: grid;
		place-items: center;
		inline-size: auto;
		max-width: none;
		block-size: auto;
		max-height: none;
		margin: 0;
		padding: min(4vw, 2rem);
		box-sizing: border-box;
		color: var(--color-background);
		background: rgb(0 0 0 / 55%);
		border: 0;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
	}

	.schedule-dialog[hidden] {
		display: none;
	}

	.schedule-dialog__panel {
		position: relative;
		align-self: center;
		justify-self: center;
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.82fr);
		box-sizing: border-box;
		width: min(100%, 58rem);
		max-width: 100%;
		height: min(43rem, calc(100dvh - 4rem));
		max-height: calc(100dvh - 4rem);
		overflow: hidden;
		background: var(--color-foreground);
		border: 3px solid var(--color-background);
		border-radius: 1.5rem;
		box-shadow: 0.4rem 0.4rem 0 0 var(--color-orange);
	}

	.schedule-dialog__panel--no-image {
		grid-template-columns: minmax(0, 1fr);
		width: min(100%, 42rem);
	}

	.schedule-dialog__image-wrap {
		order: 2;
		min-height: 25rem;
		background: var(--color-soft-blue);
	}

	.schedule-dialog__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.schedule-dialog__content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		min-height: 0;
		overflow-y: auto;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.schedule-dialog__title {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.6rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.08;
		text-wrap: balance;
	}

	.schedule-dialog__description {
		margin: 0;
		color: color-mix(in srgb, var(--color-background) 82%, transparent);
		font-size: clamp(1rem, 1.6vw, 1.18rem);
		font-weight: 700;
		line-height: 1.75;
	}

	.schedule-dialog__description :global(:first-child) {
		margin-top: 0;
	}

	.schedule-dialog__description :global(:last-child) {
		margin-bottom: 0;
	}

	.schedule-dialog__description :global(p) {
		margin-block: 0.75rem;
	}

	.schedule-dialog__description :global(ul),
	.schedule-dialog__description :global(ol) {
		display: grid;
		gap: 0.45rem;
		margin-block: 0.85rem;
		padding-inline-start: 0;
		list-style: none;
	}

	.schedule-dialog__description :global(li) {
		position: relative;
		padding-inline-start: 1.35rem;
	}

	.schedule-dialog__description :global(li::before) {
		position: absolute;
		inset-block-start: 0.72em;
		inset-inline-start: 0;
		width: 0.46rem;
		aspect-ratio: 1;
		background: var(--color-orange);
		border: 1px solid color-mix(in srgb, var(--color-background) 60%, transparent);
		border-radius: 999rem;
		box-shadow: 0.08rem 0.08rem 0 0 rgb(0 0 0 / 30%);
		content: "";
	}

	.schedule-dialog__description :global(a) {
		color: var(--color-sky-blue);
		text-decoration: underline;
		text-decoration-thickness: 0.1em;
		text-underline-offset: 0.18em;
	}

	.schedule-dialog__description :global(code) {
		padding: 0.08rem 0.3rem;
		color: var(--color-background);
		background: rgb(249 245 239 / 12%);
		border-radius: 0.35rem;
	}

	.schedule-dialog__speakers {
		display: grid;
		gap: 0.85rem;
		margin-top: auto;
		padding-top: 0.25rem;
	}

	.schedule-speaker {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.85rem;
		align-items: center;
		padding: 0.9rem;
		color: var(--color-background);
		background: rgb(249 245 239 / 8%);
		border: 2px solid rgb(249 245 239 / 14%);
		border-radius: 1rem;
	}

	.schedule-speaker__avatar {
		display: block;
		width: 3.5rem;
		aspect-ratio: 1;
		object-fit: cover;
		background: var(--color-soft-blue);
		border: 2px solid rgb(249 245 239 / 18%);
		border-radius: 999rem;
	}

	.schedule-speaker__avatar--placeholder {
		display: grid;
		place-items: center;
		color: var(--color-foreground);
		font-size: 1.4rem;
		font-weight: 800;
		line-height: 1;
		background: var(--color-green);
	}

	.schedule-speaker__content {
		min-width: 0;
	}

	.schedule-speaker__name {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.3;
	}

	.schedule-speaker__description {
		margin: 0.2rem 0 0;
		color: color-mix(in srgb, var(--color-background) 72%, transparent);
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.6;
	}

	.schedule-speaker__description--pending {
		color: color-mix(in srgb, var(--color-background) 52%, transparent);
		font-size: 0.88rem;
	}

	.schedule-dialog__close {
		position: absolute;
		inset-block-start: 0.8rem;
		inset-inline-end: 0.8rem;
		display: grid;
		place-items: center;
		width: 2.75rem;
		aspect-ratio: 1;
		color: var(--color-background);
		cursor: pointer;
		background: rgb(36 39 46 / 72%);
		border: 2px solid rgb(249 245 239 / 25%);
		border-radius: 999rem;
		transition:
			background 160ms ease,
			transform 160ms ease;
	}

	.schedule-dialog__close:hover {
		background: var(--color-foreground);
		transform: rotate(6deg);
	}

	@media (max-width: 72rem) {
		.schedule-board {
			grid-template-columns: 3.45rem minmax(0, 1fr);
			gap: 0.55rem;
			--schedule-header-row: 5.8rem;
			--schedule-slot-row: 5.1rem;
		}

		.schedule-days-track {
			gap: 0.55rem;
		}

		.schedule-time-rail__period {
			font-size: 0.88rem;
			border-radius: 0.9rem 0;
			box-shadow: 0.14rem 0.14rem 0 0 var(--color-orange);
		}

		.schedule-day {
			border-width: 2px;
			border-radius: 1rem 0;
			box-shadow: 0.18rem 0.18rem 0 0 var(--day-accent);
		}

		.schedule-day__header {
			gap: 0.3rem;
			padding: 0.62rem;
		}

		.schedule-day__header-copy {
			gap: 0.28rem;
		}

		.schedule-block {
			padding: 0.36rem;
			box-shadow: inset 0 2px 0 0 var(--color-foreground);
		}

		.schedule-block__empty-text {
			margin: 0;
		}

		.schedule-event {
			border-radius: 0.7rem 0;
			box-shadow: 0.1rem 0.1rem 0 0 var(--day-accent);
		}

		.schedule-event__body {
			padding: 0.58rem;
		}

		.schedule-event:not(.schedule-event--static):hover,
		.schedule-event:focus-visible {
			box-shadow: 0.16rem 0.16rem 0 0 var(--day-accent);
		}
	}

	@media (max-width: 58rem) {
		.schedule-board {
			grid-template-columns: 3.2rem minmax(0, 1fr);
			--schedule-header-row: 5.8rem;
			--schedule-slot-row: 5rem;
		}

		.schedule-time-rail__period {
			font-size: 0.9rem;
		}

		.schedule-day__header {
			padding: 0.5rem;
		}

		.schedule-day__subtitle {
			font-size: 0.62rem;
		}

		.schedule-day__title {
			font-size: clamp(0.84rem, 1.7vw, 1rem);
		}

		.schedule-block {
			padding: 0.42rem;
		}

		.schedule-event {
			min-height: 0;
		}

		.schedule-event__body {
			padding: 0.56rem;
		}
	}

	@media (max-width: 48rem) {
		.schedule-page {
			padding-block-start: 7.25rem;
		}

		.schedule-board {
			margin-block-start: 1rem;
		}

		.schedule-board:not(.schedule-board--scroll) {
			grid-template-columns: 1fr;
			gap: 1rem;
			overflow-x: visible;
			padding-block-end: 0;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-time-rail {
			display: none;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-days-track {
			grid-template-columns: 1fr;
			min-width: 0;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day {
			grid-template-rows: auto;
			border-radius: 1.2rem 0;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day__header {
			justify-content: center;
			padding: 0.85rem 1rem;
			text-align: center;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day__header-copy {
			justify-items: center;
			gap: 0.36rem;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day__subtitle {
			font-size: 0.8rem;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day__title {
			font-size: 1.55rem;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-day__blocks {
			display: grid;
			gap: 1rem;
			padding: 1rem;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-block {
			gap: 0.55rem;
			grid-row: auto;
			min-height: 0;
			padding: 0;
			border-block-start: 0;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-block__events {
			grid-auto-rows: max-content;
			height: auto;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-block__period {
			position: static;
			justify-self: start;
			align-self: start;
			width: auto;
			height: auto;
			overflow: visible;
			clip: auto;
			clip-path: none;
			color: var(--color-background);
			font-size: 0.95rem;
			font-weight: 800;
			line-height: 1;
			white-space: normal;
		}

		.schedule-board:not(.schedule-board--scroll) .schedule-event {
			height: auto;
			min-height: 9rem;
