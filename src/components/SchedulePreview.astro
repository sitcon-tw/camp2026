---
import type { ImageMetadata } from "astro";
import Info from "~icons/lucide/info";
import X from "~icons/lucide/x";
import { SCHEDULE_CACHE_TTL_MS, SCHEDULE_SHEET_RANGES, SCHEDULE_SPREADSHEET_ID } from "@/lib/schedule";

const scheduleShell = {
	title: "活動日程",
	description: "正在載入最新活動日程。"
};
const initialScheduleSlotCount = 0;

const scheduleImageModules = import.meta.glob<{ default: ImageMetadata }>("../assets/schedule/*.{jpg,jpeg,png,webp}", { eager: true });
const scheduleImages = new Map(
	Object.entries(scheduleImageModules).map(([path, mod]) => {
		const filename = path.split("/").pop() ?? path;
		const key = filename.replace(/\.(jpe?g|png|webp)$/i, "");
		return [key, mod.default];
	})
);
const speakerAvatarModules = import.meta.glob<{ default: ImageMetadata }>(["../assets/speakers/*.{jpg,jpeg,png,webp}", "../assets/feature-members/*.{jpg,jpeg,png,webp}"], { eager: true });
const speakerAvatars = new Map(
	Object.entries(speakerAvatarModules).map(([path, mod]) => {
		const filename = path.split("/").pop() ?? path;
		const key = filename.replace(/\.(jpe?g|png|webp)$/i, "");
		return [key, mod.default];
	})
);
const imageMetadataToManifestEntry = (image: ImageMetadata) => ({
	src: image.src,
	width: image.width,
	height: image.height
});
const scheduleImageManifest = Object.fromEntries(Array.from(scheduleImages.entries()).map(([key, image]) => [key, imageMetadataToManifestEntry(image)]));
const speakerAvatarManifest = Object.fromEntries(Array.from(speakerAvatars.entries()).map(([key, image]) => [key, imageMetadataToManifestEntry(image)]));
const scheduleClientConfigJson = JSON.stringify({
	spreadsheetId: SCHEDULE_SPREADSHEET_ID,
	cacheTtlMs: SCHEDULE_CACHE_TTL_MS,
	ranges: SCHEDULE_SHEET_RANGES,
	images: scheduleImageManifest,
	avatars: speakerAvatarManifest
}).replace(/</g, "\\u003c");
---

<section class="schedule-page" aria-labelledby="schedule-title">
	<div class="schedule-page__content" data-schedule-page-content>
		<div class="site-container">
			<header class="schedule-hero">
				<p class="schedule-hero__eyebrow">SITCON Camp 2026</p>
				<h1 id="schedule-title" class="schedule-hero__title">{scheduleShell.title}</h1>
				<p class="schedule-hero__lead">{scheduleShell.description}</p>
			</header>

			<div class="schedule-status schedule-status--loading" data-schedule-status role="status">正在載入最新活動日程。</div>

			<div class="schedule-notes" data-schedule-notes hidden></div>

			<div class="schedule-board schedule-board--scroll" data-schedule-board style={`--schedule-slot-count:${initialScheduleSlotCount};`} aria-label="五天活動日程輪廓">
				<div class="schedule-time-rail" data-schedule-time-rail aria-hidden="true">
					<div class="schedule-time-rail__spacer"></div>
				</div>

				<div class="schedule-days-track" data-schedule-days-track></div>
			</div>
		</div>
	</div>

	<div data-schedule-dialog-root></div>
</section>

<script id="schedule-client-config" type="application/json" set:html={scheduleClientConfigJson} is:inline />

<template id="schedule-info-icon-template">
	<Info class="schedule-event__info-icon" width={18} height={18} stroke-width={3} aria-hidden="true" />
</template>

<template id="schedule-close-icon-template">
	<X width={24} height={24} stroke-width={3} />
</template>

<script>
	import {
		googleVisualizationResponseToValues,
		parseScheduleSheetValues,
		validateScheduleData,
		type GoogleVisualizationResponse,
		type ScheduleCategory,
		type ScheduleData,
		type ScheduleDay,
		type ScheduleEvent,
		type ScheduleSheetValues,
		type ScheduleSpeaker
	} from "@/lib/schedule";
	import { renderMarkdown } from "@/utils/markdown";

	interface ImageManifestEntry {
		src: string;
		width: number;
		height: number;
	}

	interface ScheduleClientConfig {
		spreadsheetId: string;
		cacheTtlMs: number;
		ranges: Record<string, string>;
		images: Record<string, ImageManifestEntry>;
		avatars: Record<string, ImageManifestEntry>;
	}

	interface CachedSchedule {
		timestamp: number;
		data: ScheduleData;
	}

	interface RenderableScheduleBlock {
		startSlot: string;
		span: number;
		eventId: string;
		event: ScheduleEvent | null;
		isInteractive: boolean;
		label: string;
		rowStart: number;
	}

	const dayAccentClassMap: Record<string, string> = {
		opening: "schedule-day--sky",
		software: "schedule-day--green",
		"artificial-intelligence": "schedule-day--orange",
		security: "schedule-day--blue",
		closing: "schedule-day--dark"
	};

	const cacheKeyPrefix = "sitcon-camp-2026:schedule";
	const focusableSelector = [
		"a[href]",
		"button:not([disabled])",
		'input:not([disabled]):not([type="hidden"])',
		"select:not([disabled])",
		"textarea:not([disabled])",
		'[tabindex]:not([tabindex="-1"])'
	].join(",");

	const escapeHtml = (value: unknown): string =>
		String(value ?? "").replace(/[&<>"']/g, char => {
			const entities: Record<string, string> = {
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#39;"
			};
			return entities[char] ?? char;
		});

	const readConfig = (): ScheduleClientConfig => {
		const configElement = document.querySelector<HTMLScriptElement>("#schedule-client-config");
		if (!configElement?.textContent) throw new Error("Missing schedule client config");
		return JSON.parse(configElement.textContent) as ScheduleClientConfig;
	};

	const getTemplateHtml = (selector: string): string => document.querySelector<HTMLTemplateElement>(selector)?.innerHTML.trim() ?? "";

	const getAstroScopeAttribute = (): string | null => {
		const schedulePage = document.querySelector(".schedule-page");
		return Array.from(schedulePage?.attributes ?? []).find(attribute => attribute.name.startsWith("data-astro-cid-"))?.name ?? null;
	};

	const applyAstroScope = (root: Element | null, scopeAttribute: string | null) => {
		if (!root || !scopeAttribute) return;

		root.setAttribute(scopeAttribute, "");
		root.querySelectorAll("*").forEach(element => element.setAttribute(scopeAttribute, ""));
	};

	const descriptionLinesToMarkdown = (lines: string[]): string =>
		lines.reduce((markdown, line) => {
			const previousLine = markdown.split("\n").at(-1) ?? "";
			const joinsList = /^[-*+]\s+/.test(line) && /^[-*+]\s+/.test(previousLine);
			const separator = joinsList ? "\n" : "\n\n";

			return markdown ? `${markdown}${separator}${line}` : line;
		}, "");

	const getCategory = (event: ScheduleEvent, categoriesById: Map<string, ScheduleCategory>): ScheduleCategory => {
		const category = categoriesById.get(event.categoryId);
		if (!category) throw new Error(`Missing schedule category: ${event.categoryId}`);
		return category;
	};

	const getEventSpeakers = (event: ScheduleEvent, speakersById: Map<string, ScheduleSpeaker>): ScheduleSpeaker[] =>
		(event.speakers ?? [])
			.map(speakerId => {
				const speaker = speakersById.get(speakerId);
				if (!speaker) throw new Error(`Missing schedule speaker: ${speakerId}`);
				return speaker;
			})
			.filter(speaker => Boolean(speaker.name?.trim() || speaker.description?.trim() || speaker.avatar?.key?.trim()));

	const hasEventDetails = (event: ScheduleEvent, speakersById: Map<string, ScheduleSpeaker>): boolean => {
		const descriptionLines = event.description ?? [];
		return Boolean(event.image?.key || descriptionLines.some(line => line.trim()) || getEventSpeakers(event, speakersById).length > 0);
	};

	const getBlockRangeLabel = (startSlot: string, span: number, slots: string[]): string => {
		const startIndex = slots.indexOf(startSlot);
		const endSlot = slots[startIndex + span - 1] ?? startSlot;
		return startSlot === endSlot ? startSlot : `${startSlot} - ${endSlot}`;
	};

	const getRenderableBlocks = (day: ScheduleDay, data: ScheduleData, eventsById: Map<string, ScheduleEvent>, speakersById: Map<string, ScheduleSpeaker>): RenderableScheduleBlock[] => {
		const occupiedSlots = Array.from({ length: data.slots.length }, () => false);
		const blocks = day.blocks.map(block => {
			const startIndex = data.slots.indexOf(block.startSlot);
			if (startIndex === -1) throw new Error(`Invalid schedule slot: ${block.startSlot}`);

			for (let offset = 0; offset < block.span; offset += 1) {
				const slotIndex = startIndex + offset;
				if (occupiedSlots[slotIndex]) throw new Error(`Overlapping schedule blocks in day: ${day.id}`);
				occupiedSlots[slotIndex] = true;
			}

			const event = eventsById.get(block.eventId);
			if (!event) throw new Error(`Missing schedule event: ${block.eventId}`);

			return {
				...block,
				event,
				isInteractive: event.isInteractive === true && hasEventDetails(event, speakersById),
				label: getBlockRangeLabel(block.startSlot, block.span, data.slots),
				rowStart: startIndex + 2
			};
		});

		const emptyBlocks = data.slots.flatMap((slot, index) =>
			occupiedSlots[index]
				? []
				: [
						{
							startSlot: slot,
							span: 1,
							eventId: "",
							event: null,
							isInteractive: false,
							label: slot,
							rowStart: index + 2
						}
					]
		);

		return [...blocks, ...emptyBlocks].sort((left, right) => left.rowStart - right.rowStart);
	};

	const renderBadge = (category: ScheduleCategory, className: string): string => `<span class="${className} schedule-badge--${escapeHtml(category.theme)}">${escapeHtml(category.label)}</span>`;

	const renderScheduleEvent = (block: RenderableScheduleBlock, categoriesById: Map<string, ScheduleCategory>, infoIconHtml: string): string => {
		const event = block.event;
		if (!event) return `<p class="schedule-block__empty-text"> </p>`;

		const category = getCategory(event, categoriesById);
		const eventClasses = ["schedule-event", block.isInteractive ? "" : "schedule-event--static", block.span > 1 ? "schedule-event--spanning" : ""].filter(Boolean).join(" ");
		const body = `
			<div class="schedule-event__body">
				<div class="schedule-event__content">
					${renderBadge(category, "schedule-event__badge")}
					<span class="schedule-event__name">${escapeHtml(event.name)}</span>
				</div>
			</div>
		`;

		if (!block.isInteractive) {
			return `<div class="${eventClasses}">${body}</div>`;
		}

		return `
			<button type="button" class="${eventClasses}" data-schedule-event-trigger="${escapeHtml(event.id)}" aria-label="查看${escapeHtml(event.name)}介紹">
				${body}
				${infoIconHtml}
			</button>
		`;
	};

	const renderDay = (
		day: ScheduleDay,
		data: ScheduleData,
		eventsById: Map<string, ScheduleEvent>,
		speakersById: Map<string, ScheduleSpeaker>,
		categoriesById: Map<string, ScheduleCategory>,
		infoIconHtml: string
	): string => {
		const title = day.title.map((entry, index) => `${index === 0 ? "" : "<wbr>"}<span class="schedule-day__title-entry">${escapeHtml(entry)}</span>`).join("");

		const blocks = getRenderableBlocks(day, data, eventsById, speakersById)
			.map(block => {
				const blockClasses = ["schedule-block", block.event ? "" : "schedule-block--empty", block.span > 1 ? "schedule-block--spanning" : ""].filter(Boolean).join(" ");
				return `
					<section class="${blockClasses}" style="--schedule-block-row:${block.rowStart}; --schedule-block-span:${block.span};" aria-label="${escapeHtml(day.title.join(" "))}${escapeHtml(block.label)}活動">
						<h3 class="schedule-block__period">${escapeHtml(block.label)}</h3>
						${block.event ? `<div class="schedule-block__events">${renderScheduleEvent(block, categoriesById, infoIconHtml)}</div>` : renderScheduleEvent(block, categoriesById, infoIconHtml)}
					</section>
				`;
			})
			.join("");

		return `
			<article class="schedule-day ${dayAccentClassMap[day.type] ?? "schedule-day--dark"}">
				<header class="schedule-day__header">
					<div class="schedule-day__header-copy">
						<h2 class="schedule-day__title">${title}</h2>
						<p class="schedule-day__subtitle">
							${escapeHtml(day.subtitle)}
							<span class="schedule-day__date"> - ${escapeHtml(day.date)}</span>
						</p>
					</div>
				</header>
				<div class="schedule-day__blocks">${blocks}</div>
			</article>
		`;
	};

	const renderSpeaker = (speaker: ScheduleSpeaker, config: ScheduleClientConfig): string => {
		const avatar = speaker.avatar?.key ? config.avatars[speaker.avatar.key] : null;
		const avatarAlt = speaker.avatar?.alt ?? speaker.name ?? "";
		const speakerDescription = speaker.description?.trim();

		return `
			<article class="schedule-speaker">
				${
					avatar
						? `<img class="schedule-speaker__avatar" src="${escapeHtml(avatar.src)}" alt="${escapeHtml(avatarAlt)}" loading="lazy" decoding="async" width="${avatar.width}" height="${avatar.height}">`
						: `<div class="schedule-speaker__avatar schedule-speaker__avatar--placeholder" aria-hidden="true">${escapeHtml(speaker.name?.trim().charAt(0) ?? "")}</div>`
				}
				<div class="schedule-speaker__content">
					${speaker.name?.trim() ? `<h3 class="schedule-speaker__name">${escapeHtml(speaker.name)}</h3>` : ""}
					<p class="schedule-speaker__description ${speakerDescription ? "" : "schedule-speaker__description--pending"}">${escapeHtml(speakerDescription || "講者介紹即將公開")}</p>
				</div>
			</article>
		`;
	};

	const renderDialog = (
		event: ScheduleEvent,
		config: ScheduleClientConfig,
		categoriesById: Map<string, ScheduleCategory>,
		speakersById: Map<string, ScheduleSpeaker>,
		closeIconHtml: string
	): string => {
		const category = getCategory(event, categoriesById);
		const descriptionLines = event.description ?? [];
		const image = event.image?.key ? config.images[event.image.key] : null;
		const imageAlt = event.image?.alt ?? "";
		const speakers = getEventSpeakers(event, speakersById);
		const description = descriptionLines.some(line => line.trim()) ? `<div class="schedule-dialog__description">${renderMarkdown(descriptionLinesToMarkdown(descriptionLines))}</div>` : "";
		const speakersHtml =
			speakers.length > 0 ? `<section class="schedule-dialog__speakers" aria-label="${escapeHtml(event.name)}講者">${speakers.map(speaker => renderSpeaker(speaker, config)).join("")}</section>` : "";

		return `
			<div class="schedule-dialog" data-schedule-dialog="${escapeHtml(event.id)}" role="dialog" aria-modal="true" aria-labelledby="schedule-dialog-title-${escapeHtml(event.id)}" hidden>
				<div class="schedule-dialog__panel ${image ? "" : "schedule-dialog__panel--no-image"}">
					${
						image
							? `<div class="schedule-dialog__image-wrap"><img class="schedule-dialog__image" src="${escapeHtml(image.src)}" alt="${escapeHtml(imageAlt)}" loading="lazy" decoding="async" width="${image.width}" height="${image.height}"></div>`
							: ""
					}
					<div class="schedule-dialog__content">
						${renderBadge(category, "schedule-dialog__badge")}
						<h2 id="schedule-dialog-title-${escapeHtml(event.id)}" class="schedule-dialog__title" tabindex="-1">${escapeHtml(event.name)}</h2>
						${description}
						${speakersHtml}
					</div>
					<button type="button" class="schedule-dialog__close" data-schedule-dialog-close aria-label="關閉${escapeHtml(event.name)}介紹">${closeIconHtml}</button>
				</div>
			</div>
		`;
	};

	const fetchSheetValues = (config: ScheduleClientConfig, sheetName: string, range: string, signal: AbortSignal): Promise<string[][]> =>
		new Promise((resolve, reject) => {
			if (signal.aborted) {
				reject(new DOMException("Aborted", "AbortError"));
				return;
			}

			const callbackName = `__scheduleSheetCallback${Date.now()}${Math.random().toString(36).slice(2)}`;
			const script = document.createElement("script");
			const url = new URL(`https://docs.google.com/spreadsheets/d/${config.spreadsheetId}/gviz/tq`);
			const timeout = window.setTimeout(() => {
				cleanup();
				reject(new Error(`${sheetName}: Google Sheets request timed out`));
			}, 15000);
			const cleanup = () => {
				window.clearTimeout(timeout);
				delete (window as unknown as Record<string, unknown>)[callbackName];
				script.remove();
			};

			(window as unknown as Record<string, (response: GoogleVisualizationResponse) => void>)[callbackName] = response => {
				try {
					const values = googleVisualizationResponseToValues(response);
					cleanup();
					resolve(values);
				} catch (error) {
					cleanup();
					reject(error);
				}
			};

			script.onerror = () => {
				cleanup();
				reject(new Error(`${sheetName}: failed to load Google Sheets script`));
			};
			signal.addEventListener(
				"abort",
				() => {
					cleanup();
					reject(new DOMException("Aborted", "AbortError"));
				},
				{ once: true }
			);

			url.searchParams.set("tqx", `out:json;responseHandler:${callbackName}`);
			url.searchParams.set("headers", "1");
			url.searchParams.set("sheet", sheetName);
			url.searchParams.set("range", range);
			url.searchParams.set("cachebust", String(Date.now()));
			script.src = url.href;
			document.head.append(script);
		});

	const fetchScheduleValues = async (config: ScheduleClientConfig, signal: AbortSignal): Promise<ScheduleSheetValues> => {
		const entries = await Promise.all(Object.entries(config.ranges).map(async ([sheetName, range]) => [sheetName, await fetchSheetValues(config, sheetName, range, signal)]));
		return Object.fromEntries(entries);
	};

	const readCachedSchedule = (config: ScheduleClientConfig, imageKeys: ReadonlySet<string>, avatarKeys: ReadonlySet<string>): CachedSchedule | null => {
		try {
			const raw = window.localStorage.getItem(`${cacheKeyPrefix}:${config.spreadsheetId}:v3`);
			if (!raw) return null;
			const cache = JSON.parse(raw) as CachedSchedule;
			if (!Number.isFinite(cache.timestamp)) return null;
			const issues = validateScheduleData(cache.data, { imageKeys, avatarKeys });
			return issues.length === 0 ? cache : null;
		} catch {
			return null;
		}
	};

	const writeCachedSchedule = (config: ScheduleClientConfig, data: ScheduleData) => {
		try {
			window.localStorage.setItem(`${cacheKeyPrefix}:${config.spreadsheetId}:v3`, JSON.stringify({ timestamp: Date.now(), data }));
		} catch {
			// localStorage may be unavailable in private browsing or strict privacy modes.
		}
	};

	document.addEventListener("astro:page-load", () => {
		const ac = new AbortController();
		const { signal } = ac;
		document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });

		const config = readConfig();
		const imageKeys = new Set(Object.keys(config.images));
		const avatarKeys = new Set(Object.keys(config.avatars));
		const infoIconHtml = getTemplateHtml("#schedule-info-icon-template");
		const closeIconHtml = getTemplateHtml("#schedule-close-icon-template");
		const title = document.querySelector<HTMLElement>("[data-schedule-page-content] #schedule-title");
		const lead = document.querySelector<HTMLElement>(".schedule-hero__lead");
		const status = document.querySelector<HTMLElement>("[data-schedule-status]");
		const notes = document.querySelector<HTMLElement>("[data-schedule-notes]");
		const board = document.querySelector<HTMLElement>("[data-schedule-board]");
		const timeRail = document.querySelector<HTMLElement>("[data-schedule-time-rail]");
		const daysTrack = document.querySelector<HTMLElement>("[data-schedule-days-track]");
		const dialogRoot = document.querySelector<HTMLElement>("[data-schedule-dialog-root]");
		const pageContent = document.querySelector<HTMLElement>("[data-schedule-page-content]");
		const astroScopeAttribute = getAstroScopeAttribute();
		let dialogs = new Map<string, HTMLElement>();
		let activeDialog: HTMLElement | null = null;
		let lastFocusedElement: HTMLElement | null = null;
		let scrollPosition = 0;

		const setStatus = (kind: "loading" | "stale" | "error", message: string) => {
			if (!status) return;
			status.hidden = false;
			status.className = `schedule-status schedule-status--${kind}`;
			status.textContent = message;
			status.setAttribute("role", kind === "error" ? "alert" : "status");
		};

		const clearStatus = () => {
			if (!status) return;
			status.hidden = true;
			status.textContent = "";
		};

		const setPageContentInert = (isInert: boolean) => {
			if (!pageContent) return;

			const pageContentWithInert = pageContent as HTMLElement & { inert?: boolean };
			if ("inert" in pageContentWithInert) {
				pageContentWithInert.inert = isInert;
			}
			pageContent.toggleAttribute("inert", isInert);
			if (isInert) {
				pageContent.setAttribute("aria-hidden", "true");
			} else {
				pageContent.removeAttribute("aria-hidden");
			}
		};

		const getFocusableElements = (dialog: HTMLElement) => Array.from(dialog.querySelectorAll<HTMLElement>(focusableSelector)).filter(element => !element.closest("[hidden]"));

		const refreshDialogs = () => {
			dialogs = new Map(Array.from(document.querySelectorAll<HTMLElement>("[data-schedule-dialog]")).map(dialog => [dialog.dataset.scheduleDialog ?? "", dialog]));
		};

		const restoreFocus = (dialog: HTMLElement | null) => {
			const fallbackTrigger = dialog?.dataset.scheduleDialog
				? Array.from(document.querySelectorAll<HTMLElement>("[data-schedule-event-trigger]")).find(trigger => trigger.dataset.scheduleEventTrigger === dialog.dataset.scheduleDialog)
				: null;
			const target = lastFocusedElement && lastFocusedElement.isConnected && (!dialog || !dialog.contains(lastFocusedElement)) ? lastFocusedElement : fallbackTrigger;

			target?.focus({ preventScroll: true });
			lastFocusedElement = null;
		};

		const closeDialog = (dialog = activeDialog) => {
			if (!dialog) return;

			dialog.hidden = true;
			setPageContentInert(false);
			activeDialog = null;
			document.documentElement.classList.remove("schedule-dialog-is-open");
			window.scrollTo({ top: scrollPosition, left: 0, behavior: "auto" });
			restoreFocus(dialog);
		};

		const openDialog = (dialog: HTMLElement) => {
			if (activeDialog && activeDialog !== dialog) closeDialog(activeDialog);

			lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			scrollPosition = window.scrollY;
			setPageContentInert(true);
			document.documentElement.classList.add("schedule-dialog-is-open");
			dialog.hidden = false;
			activeDialog = dialog;
			dialog.querySelector<HTMLElement>(".schedule-dialog__title")?.focus({ preventScroll: true });
			if (document.activeElement === lastFocusedElement) dialog.querySelector<HTMLElement>("[data-schedule-dialog-close]")?.focus({ preventScroll: true });
		};

		const renderSchedule = (data: ScheduleData) => {
			const eventsById = new Map(data.events.map(event => [event.id, event]));
			const speakersById = new Map(data.speakers.map(speaker => [speaker.id, speaker]));
			const categoriesById = new Map(data.categories.map(category => [category.id, category]));

			if (title) title.textContent = data.meta.title;
			if (lead) lead.textContent = data.meta.description;
			if (notes) {
				notes.hidden = !data.meta.note;
				notes.innerHTML = data.meta.note ? `<p class="schedule-note">${escapeHtml(data.meta.note)}</p>` : "";
				applyAstroScope(notes, astroScopeAttribute);
			}
			if (board) board.style.setProperty("--schedule-slot-count", String(data.slots.length));
			if (timeRail) {
				timeRail.innerHTML = `<div class="schedule-time-rail__spacer"></div>${data.slots.map(slot => `<div class="schedule-time-rail__period">${escapeHtml(slot)}</div>`).join("")}`;
				applyAstroScope(timeRail, astroScopeAttribute);
			}
			if (daysTrack) {
				daysTrack.innerHTML = data.days.map(day => renderDay(day, data, eventsById, speakersById, categoriesById, infoIconHtml)).join("");
				applyAstroScope(daysTrack, astroScopeAttribute);
			}
			if (dialogRoot) {
				dialogRoot.innerHTML = data.events
					.filter(event => event.isInteractive === true && hasEventDetails(event, speakersById))
					.map(event => renderDialog(event, config, categoriesById, speakersById, closeIconHtml))
					.join("");
				applyAstroScope(dialogRoot, astroScopeAttribute);
			}
			refreshDialogs();
		};

		document.addEventListener(
			"click",
			event => {
				if (!(event.target instanceof Element)) return;

				const trigger = event.target.closest<HTMLElement>("[data-schedule-event-trigger]");
				const closeButton = event.target.closest<HTMLElement>("[data-schedule-dialog-close]");
				const dialogBackdrop = event.target.closest<HTMLElement>("[data-schedule-dialog]");

				if (trigger) {
					const dialog = dialogs.get(trigger.dataset.scheduleEventTrigger ?? "");
					if (dialog) openDialog(dialog);
					return;
				}

				if (closeButton) {
					closeDialog(closeButton.closest<HTMLElement>("[data-schedule-dialog]"));
					return;
				}

				if (dialogBackdrop && event.target === dialogBackdrop) closeDialog(dialogBackdrop);
			},
			{ signal }
		);

		document.addEventListener(
			"keydown",
			event => {
				if (event.key === "Escape" && activeDialog) {
					closeDialog();
					return;
				}

				if (event.key !== "Tab" || !activeDialog) return;

				const focusables = getFocusableElements(activeDialog);
				if (focusables.length === 0) {
					event.preventDefault();
					return;
				}

				const currentIndex = focusables.indexOf(document.activeElement as HTMLElement);
				const nextIndex = event.shiftKey ? (currentIndex <= 0 ? focusables.length - 1 : currentIndex - 1) : currentIndex === -1 || currentIndex === focusables.length - 1 ? 0 : currentIndex + 1;

				event.preventDefault();
				focusables[nextIndex]?.focus({ preventScroll: true });
			},
			{ signal }
		);

		document.addEventListener(
			"focusin",
			event => {
				if (!activeDialog || !(event.target instanceof Node) || activeDialog.contains(event.target)) return;

				const focusables = getFocusableElements(activeDialog);
				(focusables[0] ?? activeDialog.querySelector<HTMLElement>("[data-schedule-dialog-close]"))?.focus({ preventScroll: true });
			},
			{ signal }
		);

		const cached = readCachedSchedule(config, imageKeys, avatarKeys);
		if (cached && Date.now() - cached.timestamp <= config.cacheTtlMs) {
			renderSchedule(cached.data);
			clearStatus();
			return;
		}

		setStatus("loading", "正在載入最新活動日程。");

		fetchScheduleValues(config, signal)
			.then(values => {
				const data = parseScheduleSheetValues(values, { imageKeys, avatarKeys });
				writeCachedSchedule(config, data);
				renderSchedule(data);
				clearStatus();
			})
			.catch(error => {
				if (signal.aborted) return;

				const staleCache = cached ?? readCachedSchedule(config, imageKeys, avatarKeys);
				if (staleCache) {
					renderSchedule(staleCache.data);
					setStatus("stale", "目前顯示暫存課表，資料可能不是最新。");
					console.warn(error);
					return;
				}

				setStatus("error", "課表暫時無法載入，請稍後再試。");
				console.error(error);
			});
	});
</script>

