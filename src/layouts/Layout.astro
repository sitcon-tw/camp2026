---
import { Font } from "astro:assets";
import ClientRouter from "astro/components/ClientRouter.astro";
import Footer from "@/components/Footer.astro";
import "../styles/global.css";
import Header from "@components/Header.astro";
import layoutData from "@/data/layout.json";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	type?: "website" | "article";
	noindex?: boolean;
	additionalStructuredData?: object | object[];
}

const { title, description, ogImage, type = "website", noindex = false, additionalStructuredData } = Astro.props;
const { document: pageDocument } = layoutData;

const siteURL = Astro.site ?? new URL("https://sitcon.camp");
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const seoData = {
	title: title ?? pageDocument.defaultTitle,
	description: description ?? pageDocument.description,
	canonicalURL: canonicalURL.href,
	ogImage: new URL(ogImage ?? "/2026/og.jpg", siteURL).href,
	ogImageAlt: pageDocument.ogImageAlt,
	ogType: type,
	robots: noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"
};
---

<!doctype html>
<html lang={pageDocument.lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<Font cssVariable="--font-line-seed-tw" preload />
		<Font cssVariable="--font-mono" preload />

		<!-- SEO: Basic Info -->
		<title>{seoData.title}</title>
		<meta name="description" content={seoData.description} />
		<meta name="robots" content={seoData.robots} />
		<meta name="googlebot" content={seoData.robots} />
		<meta name="format-detection" content="telephone=no" />
		<link rel="canonical" href={seoData.canonicalURL} />
		<link rel="sitemap" href="/2026/sitemap-index.xml" />
		<meta name="theme-color" content="#80d34b" />
		<link rel="apple-touch-icon" sizes="180x180" href="/2026/apple-touch-icon.png" />
		<link rel="icon" type="image/x-icon" href="/2026/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/2026/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/2026/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/2026/favicon-48x48.png" />
		<link rel="icon" type="image/svg+xml" href="/2026/favicon.svg" />
		<link rel="mask-icon" href="/2026/safari-pinned-tab.svg" color="#80d34b" />

		<!-- SEO: Open Graph -->
		<meta property="og:type" content={seoData.ogType} />
		<meta property="og:locale" content="zh_TW" />
		<meta property="og:site_name" content={pageDocument.brandName} />
		<meta property="og:url" content={seoData.canonicalURL} />
		<meta property="og:title" content={seoData.title} />
		<meta property="og:description" content={seoData.description} />
		<meta property="og:image" content={seoData.ogImage} />
		<meta property="og:image:secure_url" content={seoData.ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={seoData.ogImageAlt} />

		<!-- SEO: Twitter / Discord rich preview -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={seoData.title} />
		<meta name="twitter:description" content={seoData.description} />
		<meta name="twitter:image" content={seoData.ogImage} />
		<meta name="twitter:image:alt" content={seoData.ogImageAlt} />

		<!-- JSON-LD: page-specific structured data -->
		{!noindex && additionalStructuredData && <script type="application/ld+json" set:html={JSON.stringify(additionalStructuredData)} is:inline />}

		<!-- Dify Chatbot -->
		<script is:inline>
			window.difyChatbotConfig = {
				token: "pVAlJyiZRpkJ4BWb",
				baseUrl: "https://dify.nightfury.tw",
				inputs: {},
				systemVariables: {},
				userVariables: {}
			};
		</script>
		<script src="https://dify.nightfury.tw/embed.min.js" id="pVAlJyiZRpkJ4BWb" defer is:inline></script>
		<style>
			#dify-chatbot-bubble-button {
				background-color: #1c64f2 !important;
			}
			#dify-chatbot-bubble-window {
				width: 24rem !important;
				height: 40rem !important;
			}
		</style>
		<!-- End Dify Chatbot -->

		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
